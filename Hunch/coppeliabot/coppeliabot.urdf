<?xml version="1.0" ?>
<robot name="coppeliabot">

  <!-- ==================== MATERIALS ==================== -->
  <material name="chassis_blue">
    <color rgba="0.12 0.35 0.70 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="accent_yellow">
    <color rgba="0.95 0.75 0.10 1.0"/>
  </material>
  <material name="caster_silver">
    <color rgba="0.80 0.80 0.82 1.0"/>
  </material>
  <material name="sensor_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (CHASSIS) ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia ixx="0.01353" ixy="0.0" ixz="0.0"
               iyy="0.02473" iyz="0.0"
               izz="0.03453"/>
    </inertial>
    
    <!-- Visual Shape -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/chassis.stl" scale="1 1 1"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    
    <!-- Respondable Collision Shape (simplified box for physics stability) -->
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.20 0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEFT WHEEL ==================== -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000141" ixy="0.0" ixz="0.0"
               iyy="0.000253" iyz="0.0"
               izz="0.000141"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.115 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="15.0" velocity="25.0"/>
  </joint>

  <!-- ==================== RIGHT WHEEL ==================== -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000141" ixy="0.0" ixz="0.0"
               iyy="0.000253" iyz="0.0"
               izz="0.000141"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.026"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.115 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="15.0" velocity="25.0"/>
  </joint>

  <!-- ==================== FRONT CASTER ==================== -->
  <link name="front_caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000155" ixy="0.0" ixz="0.0"
               iyy="0.0000155" iyz="0.0"
               izz="0.0000155"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/caster.stl" scale="1 1 1"/>
      </geometry>
      <material name="caster_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.008" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.10 0.0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- ==================== REAR CASTER ==================== -->
  <link name="rear_caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0000155" ixy="0.0" ixz="0.0"
               iyy="0.0000155" iyz="0.0"
               izz="0.0000155"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/caster.stl" scale="1 1 1"/>
      </geometry>
      <material name="caster_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.008" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.10 0.0 -0.015" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LIDAR SENSOR ==================== -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0000713" ixy="0.0" ixz="0.0"
               iyy="0.0000713" iyz="0.0"
               izz="0.0000918"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lidar.stl" scale="1 1 1"/>
      </geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.04 0.0 0.125" rpy="0 0 0"/>
  </joint>

</robot>
