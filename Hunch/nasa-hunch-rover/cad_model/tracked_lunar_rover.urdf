<?xml version="1.0" ?>
<robot name="tracked_lunar_rover">

  <!-- ==================== MATERIALS ==================== -->
  <material name="petg_white">
    <color rgba="0.94 0.96 0.98 1.0"/>
  </material>
  <material name="track_rubber">
    <color rgba="0.20 0.22 0.25 1.0"/>
  </material>
  <material name="brass_gold">
    <color rgba="0.85 0.70 0.15 1.0"/>
  </material>
  <material name="motor_steel">
    <color rgba="0.65 0.67 0.70 1.0"/>
  </material>
  <material name="lidar_dark">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>
  <material name="camera_green">
    <color rgba="0.05 0.55 0.20 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CHASSIS (TRUSS + MAST + SENSORS) ==================== -->
  <link name="chassis_link">
    <inertial>
      <origin xyz="0.0 0.0 0.07" rpy="0 0 0"/>
      <mass value="2.85"/>
      <inertia ixx="0.0125" ixy="0.0" ixz="0.0"
               iyy="0.0215" iyz="0.0"
               izz="0.0265"/>
    </inertial>
    
    <!-- Visual Meshes -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/chassis_truss.stl" scale="1 1 1"/>
      </geometry>
      <material name="petg_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/brass_inserts.stl" scale="1 1 1"/>
      </geometry>
      <material name="brass_gold"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/sensor_mast.stl" scale="1 1 1"/>
      </geometry>
      <material name="petg_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/ydlidar.stl" scale="1 1 1"/>
      </geometry>
      <material name="lidar_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/camera_module.stl" scale="1 1 1"/>
      </geometry>
      <material name="camera_green"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/electronics_battery.stl" scale="1 1 1"/>
      </geometry>
      <material name="motor_steel"/>
    </visual>

    <!-- Collision Geometry for Physics Engine -->
    <collision>
      <origin xyz="0.0 0.0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.18 0.11"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEFT TRACK SPROCKET ==================== -->
  <link name="left_track_sprocket">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00045" ixy="0.0" ixz="0.0"
               iyy="0.00085" iyz="0.0"
               izz="0.00045"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.115 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/sprockets_wheels.stl" scale="1 1 1"/>
      </geometry>
      <material name="petg_white"/>
    </visual>
    <visual>
      <origin xyz="0 -0.115 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tracks.stl" scale="1 1 1"/>
      </geometry>
      <material name="track_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.038"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_drive_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="left_track_sprocket"/>
    <origin xyz="0.110 0.115 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="20.0"/>
  </joint>

  <!-- ==================== RIGHT TRACK SPROCKET ==================== -->
  <link name="right_track_sprocket">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00045" ixy="0.0" ixz="0.0"
               iyy="0.00085" iyz="0.0"
               izz="0.00045"/>
    </inertial>
    <visual>
      <origin xyz="0 0.115 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/sprockets_wheels.stl" scale="1 1 1"/>
      </geometry>
      <material name="petg_white"/>
    </visual>
    <visual>
      <origin xyz="0 0.115 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tracks.stl" scale="1 1 1"/>
      </geometry>
      <material name="track_rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.038"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_drive_joint" type="continuous">
    <parent link="chassis_link"/>
    <child link="right_track_sprocket"/>
    <origin xyz="0.110 -0.115 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="25.0" velocity="20.0"/>
  </joint>

  <!-- ==================== SENSOR FRAMES ==================== -->
  <link name="lidar_optical_frame"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="lidar_optical_frame"/>
    <origin xyz="-0.01 0.0 0.264" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.158 0.0 0.138" rpy="0 0.2618 0"/>
  </joint>

</robot>
