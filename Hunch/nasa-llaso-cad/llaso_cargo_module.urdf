<?xml version="1.0" ?>
<robot name="llaso_lunar_cargo_module">

  <!-- ==================== MATERIALS ==================== -->
  <material name="hull_white">
    <color rgba="0.92 0.94 0.96 1.0"/>
  </material>
  <material name="metallic_slate">
    <color rgba="0.25 0.28 0.32 1.0"/>
  </material>
  <material name="rack_aluminum">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>
  <material name="safety_orange">
    <color rgba="0.95 0.45 0.05 1.0"/>
  </material>
  <material name="ctb_blue">
    <color rgba="0.10 0.28 0.65 1.0"/>
  </material>

  <!-- ==================== CONTAINER BASE LINK ==================== -->
  <link name="cargo_container_hull">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4500.0"/>
      <inertia ixx="4500.0" ixy="0.0" ixz="0.0"
               iyy="58000.0" iyz="0.0"
               izz="58000.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/container_hull.stl" scale="1 1 1"/>
      </geometry>
      <material name="hull_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.72" rpy="0 0 0"/>
      <geometry>
        <box size="12.0 1.8 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== FLOOR & RAILS ==================== -->
  <link name="internal_infrastructure">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="800.0"/>
      <inertia ixx="300.0" ixy="0" ixz="0" iyy="8000.0" iyz="0" izz="8000.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/floor_and_rails.stl" scale="1 1 1"/>
      </geometry>
      <material name="metallic_slate"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/rack_framework.stl" scale="1 1 1"/>
      </geometry>
      <material name="rack_aluminum"/>
    </visual>
  </link>

  <joint name="infrastructure_fixed_joint" type="fixed">
    <parent link="cargo_container_hull"/>
    <child link="internal_infrastructure"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== INTERNAL CARGO ROBOT: GANTRY X CARRIAGE ==================== -->
  <link name="gantry_trolley_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="1.5" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="2.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.12"/>
      </geometry>
      <material name="safety_orange"/>
    </visual>
  </link>

  <!-- Prismatic rail joint along full 10m length of cargo module -->
  <joint name="gantry_rail_x_joint" type="prismatic">
    <parent link="internal_infrastructure"/>
    <child link="gantry_trolley_x"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-5.0" upper="5.0" effort="500.0" velocity="1.5"/>
  </joint>

  <!-- ==================== GANTRY Y-SLIDE CROSS BRIDGE ==================== -->
  <link name="gantry_cross_slide_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="0.8" ixy="0" ixz="0" iyy="0.8" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.80 0.08"/>
      </geometry>
      <material name="metallic_slate"/>
    </visual>
  </link>

  <joint name="gantry_slide_y_joint" type="prismatic">
    <parent link="gantry_trolley_x"/>
    <child link="gantry_cross_slide_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.40" upper="0.40" effort="300.0" velocity="0.8"/>
  </joint>

  <!-- ==================== VERTICAL TELESCOPING MAST (Z-AXIS) ==================== -->
  <link name="gantry_mast_z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.90"/>
      </geometry>
      <material name="rack_aluminum"/>
    </visual>
  </link>

  <joint name="gantry_mast_z_joint" type="prismatic">
    <parent link="gantry_cross_slide_y"/>
    <child link="gantry_mast_z"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.60" upper="0.20" effort="600.0" velocity="0.5"/>
  </joint>

  <!-- ==================== END-EFFECTOR GRIPPER / FORK ==================== -->
  <link name="gantry_gripper_tool">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0.15 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.30 0.05"/>
      </geometry>
      <material name="safety_orange"/>
    </visual>
  </link>

  <joint name="gripper_yaw_joint" type="revolute">
    <parent link="gantry_mast_z"/>
    <child link="gantry_gripper_tool"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="2.0"/>
  </joint>

</robot>
